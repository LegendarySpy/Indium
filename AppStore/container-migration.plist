<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- On the first sandboxed launch, macOS brings the note icons the direct-download
     Indium kept in ~/Library/Application Support/Indium into the container's
     Application Support/Indium. Preferences migrate on their own.
     https://developer.apple.com/documentation/security/migrating-your-app-s-files-to-its-app-sandbox-container -->
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/Indium/icons.json</string>
	</array>
</dict>
</plist>
